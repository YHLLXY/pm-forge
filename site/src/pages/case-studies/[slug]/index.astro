---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import { ogImageFor } from "@/utils/ogImage";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EntryHeader from "@/components/EntryHeader.astro";
import MetricCards from "@/components/MetricCards.astro";
import ArticleEnhancements from "@/components/ArticleEnhancements.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import DetailColumns from "@/components/DetailColumns.astro";
import ArticleToc from "@/components/ArticleToc.astro";
import { sortEntries } from "@/utils/sortEntries";
import { entryUrl } from "@/utils/entryUrl";

export async function getStaticPaths() {
  const entries = sortEntries(await getCollection("caseStudies"));
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<"caseStudies"> };
const { entry } = Astro.props;
const {
  title,
  description,
  pubDatetime,
  modDatetime,
  tags,
  projectRole,
  stack,
  links,
  metrics,
  resultsNote,
} = entry.data;
const { Content, headings } = await render(entry);
---

<PostLayout
  title={`${title} | 余翰林的作品集`}
  description={description}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  ogImage={ogImageFor("caseStudies", entry.id)}
>
  <Header />

  <BackButton />

  <main id="main-content" class="app-layout mt-8">
    <EntryHeader
      section="case"
      sectionLabel="案例研究"
      title={title}
      deck={description}
      {pubDatetime}
      {modDatetime}
      cover={{
        kicker: "CASE STUDY",
        date: pubDatetime,
        headline: metrics[0]?.value ?? "产品案例",
        subline: metrics[0]?.label ?? "案例研究",
        // 列表卡片用 slice(1, 4)（3 列），详情版头用 slice(1, 5)（banner 支持 4 列）——同族不同张
        facts: metrics.slice(1, 5),
      }}
    />

    <DetailColumns>
      <Fragment slot="rail">
        <ArticleToc {headings} />

        <div class="not-prose my-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
          <div class="border-border bg-surface-1 rounded-lg border p-3 text-sm">
            <p class="text-foreground/75 text-xs">我的角色</p>
            <p class="mt-1 font-medium">{projectRole}</p>
          </div>
          <div class="border-border bg-surface-1 rounded-lg border p-3 text-sm">
            <p class="text-foreground/75 text-xs">技术栈</p>
            <p class="mt-1 font-medium">{stack.join(" · ") || "—"}</p>
          </div>
        </div>

        {
          (links.live || links.repo) && (
            <p class="not-prose my-3 flex flex-wrap gap-4 text-sm">
              {links.live && (
                <a
                  class="text-accent underline decoration-dashed"
                  href={links.live}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  在线访问 ↗
                </a>
              )}
              {links.repo && (
                <a
                  class="text-accent underline decoration-dashed"
                  href={links.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  源码仓库 ↗
                </a>
              )}
            </p>
          )
        }

        <MetricCards {metrics} {resultsNote} />
      </Fragment>

      <article
        id="article"
        class:list={[
          "mt-8 w-full",
          "app-prose max-w-readable",
          "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
        ]}
      >
        <Content />
      </article>

      <hr class="my-8 border-dashed" />

      <BackToTopButton />

      {
        tags.length > 0 && (
          <ul class="mt-4 mb-8 flex flex-wrap gap-2">
            {tags.map(tag => (
              <li class="border-border bg-surface-1 text-foreground/75 rounded border px-2 py-0.5 text-xs">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </DetailColumns>
  </main>
  <Footer />
</PostLayout>

<ArticleEnhancements />
