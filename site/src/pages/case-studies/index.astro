---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { sortEntries } from "@/utils/sortEntries";
import { entryUrl } from "@/utils/entryUrl";
import { monthDay } from "@/utils/monthDay";

const cases = sortEntries(await getCollection("caseStudies"));

// 速览层用的 "MM.DD" 统一走 @/utils/monthDay（首页证据面板第 6 格也用同一份）。
// 只用月.日 而不是年月：现有 5 篇全在同两个月，写年月的每一行都一样，没有区分度。
---

<Layout title="案例研究 | 余翰林的作品集" description="把做过的项目写成产品视角的案例：背景与问题、我的角色、关键取舍、量化结果，外加可选复盘。">
  <Header />
  <main id="main-content" class="app-layout my-8">
    <h1 class="text-3xl font-bold">案例研究</h1>
    <p class="text-foreground/75 mt-3">
      把做过的项目写成产品视角的案例。每篇固定四段：背景与问题 → 我的角色 →
      过程与关键取舍 → 结果与量化，第五段「复盘与反思」可选；数字标注口径，没验证过的如实说“没验证”。
    </p>
    {
      /* 速览层：给"只想扫一眼"的读者一条 5 行的捷径，放在卡片之前是有意的 ——
         卡片是"读"，这里是"扫"。纯 HTML 零 JS；数字全部取自 frontmatter 的 metrics[0]，
         不新写任何数字（否则就会多出一份可能与正文不一致的"事实"）。 */
    }
    <section
      aria-labelledby="glance-heading"
      class="border-border bg-surface-2 mt-7 rounded-xl border p-4 sm:p-5"
    >
      <h2
        id="glance-heading"
        class="text-muted-foreground font-mono text-[11px] tracking-[0.12em] uppercase"
      >
        At a glance · 一页速览
      </h2>
      <ul class="mt-2">
        {
          cases.map(c => (
            <li class="border-border flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t py-2 text-sm first:border-t-0">
              <a
                href={entryUrl("case-studies", c.id)}
                class="hover:text-accent underline-offset-4 hover:underline"
              >
                {c.data.title}
                {c.data.maturity && (
                  <span class="text-warm ms-1.5 text-[11px] font-semibold">
                    {c.data.maturity.label.split(" · ")[0]}
                  </span>
                )}
              </a>
              <span class="text-muted-foreground shrink-0 text-xs tabular-nums">
                {monthDay(c.data.pubDatetime)}
                {c.data.metrics[0] && (
                  <span class="ms-2">
                    {c.data.metrics[0].value}
                    <span class="ms-1">{c.data.metrics[0].label}</span>
                  </span>
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <ul class="mt-6 grid gap-5 sm:grid-cols-2">
      {
        cases.map(c => (
          <Card
            variant="h2"
            href={entryUrl("case-studies", c.id)}
            title={c.data.title}
            description={c.data.description}
            pubDatetime={c.data.pubDatetime}
            modDatetime={c.data.modDatetime}
            tags={c.data.tags}
            maturity={c.data.maturity}
            cover={{
              section: "case",
              kicker: "CASE STUDY",
              date: c.data.pubDatetime,
              headline: c.data.metrics[0]?.value ?? "产品案例",
              subline: c.data.metrics[0]?.label ?? "案例研究",
              facts: c.data.metrics.slice(1, 4),
            }}
          />
        ))
      }
    </ul>
  </main>
  <Footer />
</Layout>
