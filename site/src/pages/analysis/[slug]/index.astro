---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import { ogImageFor } from "@/utils/ogImage";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EntryHeader from "@/components/EntryHeader.astro";
import ArticleEnhancements from "@/components/ArticleEnhancements.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { sortEntries } from "@/utils/sortEntries";

export async function getStaticPaths() {
  const entries = sortEntries(await getCollection("analysis"));
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<"analysis"> };
const { entry } = Astro.props;
const { title, description, pubDatetime, modDatetime, dataset, reportUrl } =
  entry.data;
const { Content } = await render(entry);
---

<PostLayout
  title={`${title} | 余翰林的作品集`}
  description={description}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  ogImage={ogImageFor("analysis", entry.id)}
>
  <Header />

  <BackButton />

  <main id="main-content" class="app-layout mt-8">
    <EntryHeader
      section="analysis"
      sectionLabel="数据分析"
      title={title}
      deck={description}
      {pubDatetime}
      {modDatetime}
      cover={{
        kicker: "DATA ANALYSIS",
        date: pubDatetime,
        headline: dataset,
        subline: "数据分析报告",
      }}
    />

    <div class="not-prose my-4">
      <div class="border-border bg-surface-1 rounded-lg border p-3 text-sm">
        <p class="text-muted-foreground text-xs">数据集</p>
        <p class="mt-1 font-medium">{dataset}</p>
      </div>
    </div>

    {
      reportUrl && (
        <div class="not-prose border-border bg-surface-1 my-4 rounded-lg border p-4">
          <p class="text-muted-foreground text-sm">
            完整分析报告（Quarto 生成，含图表与指标口径）
          </p>
          <iframe
            src={reportUrl}
            class="border-border mt-3 h-[75vh] w-full rounded border"
            loading="lazy"
            title="完整报告"
          />
          <p class="mt-2 text-sm">
            <a
              class="text-accent underline decoration-dashed"
              href={reportUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              新窗口打开完整报告 ↗
            </a>
          </p>
        </div>
      )
    }

    <article
      id="article"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-readable",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <BackToTopButton />
  </main>
  <Footer />
</PostLayout>

<ArticleEnhancements />
