---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EntryHeader from "@/components/EntryHeader.astro";
import ProvenanceBanner from "@/components/ProvenanceBanner.astro";
import ArticleEnhancements from "@/components/ArticleEnhancements.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { sortEntries } from "@/utils/sortEntries";

export async function getStaticPaths() {
  const entries = sortEntries(await getCollection("toolkitReports"));
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<"toolkitReports"> };
const { entry } = Astro.props;
const {
  title,
  description,
  pubDatetime,
  toolId,
  toolName,
  promptVersion,
  inputSummary,
  generatedBy,
} = entry.data;
const { Content } = await render(entry);
---

<PostLayout
  title={`${title} | 余翰林的作品集`}
  description={description}
  pubDatetime={pubDatetime}
>
  <Header />

  <BackButton />

  <main id="main-content" class="app-layout mt-8">
    <EntryHeader
      section="toolbox"
      sectionLabel="工具箱报告"
      title={title}
      deck={description}
      {pubDatetime}
      cover={{
        kicker: "TOOL REPORT",
        date: pubDatetime,
        headline: toolName,
        subline: generatedBy,
        facts: [{ label: "提示词版本", value: promptVersion }],
      }}
    />

    <ProvenanceBanner
      toolName={toolName}
      inputSummary={inputSummary}
      generatedBy={generatedBy}
      promptVersion={promptVersion}
      toolHref={`https://toolbox.yuhailinlxy.com/tools/${toolId}`}
    />

    <article
      id="article"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-readable",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <BackToTopButton />
  </main>
  <Footer />
</PostLayout>

<ArticleEnhancements />
