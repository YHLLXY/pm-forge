---
// site/src/pages/data-stories/userbehavior.astro —— B 线唯一故事页（B 验收⑥载体）
// 口径行（metricNote）构建期从 preset JSON 读取，页面文本与数据文件单一事实源。
import { readFileSync, statSync } from "node:fs";
import { join } from "node:path";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

// 预渲染在 dist 里跑，import.meta.url 指向编译产物；process.cwd() = site/ 才是稳定锚点
const PRESET_DIR = join(process.cwd(), "public", "assets", "data-stories", "userbehavior", "presets");
const QUIDS = ["q01", "q02", "q03", "q04", "q05", "q06", "q07", "q08", "q09", "q10"] as const;
const META = new Map(
  QUIDS.map(q => [q, JSON.parse(readFileSync(join(PRESET_DIR, `${q}.json`), "utf8")) as { title: string; metricNote: string }]),
);
const note = (qid: (typeof QUIDS)[number]) => META.get(qid)!;
// 引擎体积构建期实测注入（文案数字与发布物单一事实源，随 duckdb-wasm 升级自动更新）
const DUCKDB_DIR = join(process.cwd(), "public", "duckdb");
const ENGINE_MB = Math.round(
  ["duckdb-eh.wasm", "duckdb-browser-eh.worker.js"].reduce((sum, f) => sum + statSync(join(DUCKDB_DIR, f)).size, 0) / 1048576,
);
---

<Layout title="淘宝用户行为九日谈：一场浏览器里的复算 | 余翰林的作品集" description="100k 行抽样的淘宝用户行为数据，在浏览器内用 DuckDB-WASM 现场复算：行为结构、时间分布、类目格局与行为质量，全部口径可查、全部数字可复现。">
  <Header />
  <main id="main-content" class="app-layout my-8">
    <article class="mx-auto max-w-3xl">
      <p class="text-foreground/75 font-mono text-xs">数据故事 · UserBehavior 100k 抽样（seed=42） · 2017-11-25 → 12-03（UTC+8）</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">淘宝用户行为九日谈：一场浏览器里的复算</h1>

      <section class="story-step mt-10">
        <h2 class="text-xl font-bold sm:text-2xl">一、这是一份什么数据</h2>
        <p class="mt-3">阿里巴巴公开的淘宝用户行为数据集（UserBehavior），取其中 100,000 行随机抽样（reservoir，seed=42；抽样与清洗脚本开源在本仓库 analysis/）。字段只有五个：用户、商品、类目、行为类型、时间戳。行为分四种——pv（浏览）、cart（加购）、fav（收藏）、buy（购买）。</p>
        <p class="mt-3">抽样中混入了官方窗口外的脏时间戳（含 2030 年的「未来行为」），按与仓库分析线相同的口径剔除后，<strong>99,958 行</strong>落在 2017-11-25 至 12-03 共九天（UTC+8）内。下文每个数字都可以在页面末尾的查询框里亲手复算。</p>
        <p class="text-foreground/75 mt-4 text-xs">口径：reservoir 抽样 100k 行（seed=42）；分析窗口 2017-11-25–12-03（UTC+8），清洗后 99,958 行。</p>
      </section>

      <section class="story-step mt-16">
        <h2 class="text-xl font-bold sm:text-2xl">二、总量与结构：百分之九十四的目光</h2>
        <p class="mt-3">九天里，92,042 个用户对 81,695 个商品、3,985 个类目产生了 99,958 次行为。其中 pv 占 89.5%——接近九成的行为只是「看」；加购 5.6%、收藏 2.9%、购买 2.0%。注意力远远多于动作，是所有电商数据的第一形状。</p>
        <div class="mt-6 space-y-8">
          <figure data-chart="q01" class="m-0">
            <figcaption class="text-foreground/75 text-xs">{note("q01").title} · 口径：{note("q01").metricNote}</figcaption>
          </figure>
          <figure data-chart="q02" class="m-0">
            <figcaption class="text-foreground/75 text-xs">{note("q02").title} · 口径：{note("q02").metricNote}</figcaption>
          </figure>
        </div>
      </section>

      <section class="story-step mt-16">
        <h2 class="text-xl font-bold sm:text-2xl">三、时间维度：周末的访客潮与凌晨的低谷</h2>
        <p class="mt-3">日活（当日去重用户数）在工作日稳定在 9,500–10,500 之间。值得细看的是两个周末的分歧：11 月 25、26 日与工作日无异（10,400 上下），而 12 月 2、3 日跳升至 13,500 上下，比工作日多出三成多——「周末」本身解释不了访客潮，第六节会再回到这一点。按小时看，凌晨 0 点至 5 点是谷底，谷底在 04 点，上午 10 点后爬回平台。</p>
        <div class="mt-6 space-y-8">
          <figure data-chart="q03" class="m-0">
            <figcaption class="text-foreground/75 text-xs">{note("q03").title} · 口径：{note("q03").metricNote}</figcaption>
          </figure>
          <figure data-chart="q04" class="m-0">
            <figcaption class="text-foreground/75 text-xs">{note("q04").title} · 口径：{note("q04").metricNote}</figcaption>
          </figure>
        </div>
      </section>

      <section class="story-step mt-16">
        <h2 class="text-xl font-bold sm:text-2xl">四、类目格局：头部的宽度与转化率的小样本陷阱</h2>
        <p class="mt-3">把 pv 按类目排队，Top10 类目构成的头部有多宽？再看转化率视角——买行数除以看行数。注意口径行里的 pv≥50 门槛：样本里大量类目只有几次浏览，它们的「高转化率」只是小样本的运气，不设门槛的榜单会被这种噪音霸占。</p>
        <div class="mt-6 space-y-8">
          <figure data-chart="q05" class="m-0">
            <figcaption class="text-foreground/75 text-xs">{note("q05").title} · 口径：{note("q05").metricNote}</figcaption>
          </figure>
          <figure data-chart="q06" class="m-0">
            <figcaption class="text-foreground/75 text-xs">{note("q06").title} · 口径：{note("q06").metricNote}</figcaption>
          </figure>
        </div>
      </section>

      <section class="story-step mt-16">
        <h2 class="text-xl font-bold sm:text-2xl">五、行为质量：加购的边际与复购的稀有</h2>
        <p class="mt-3">5.99% 的用户在九天里加购过却从未购买——加购到购买之间隔着一整个决策期。复购（buy≥2）只占 0.01%：九天窗口太短，它只陈述窗口内的事实，不外推为忠诚度结论。漏斗是平行计数而非严格漏斗：看过的人里 6.7% 加购、2.5% 购买。</p>
        <div class="mt-6 space-y-8">
          <figure data-chart="q07" class="m-0">
            <figcaption class="text-foreground/75 text-xs">{note("q07").title} · 口径：{note("q07").metricNote}</figcaption>
          </figure>
          <figure data-chart="q08" class="m-0">
            <figcaption class="text-foreground/75 text-xs">{note("q08").title} · 口径：{note("q08").metricNote}</figcaption>
          </figure>
          <figure data-chart="q09" class="m-0">
            <figcaption class="text-foreground/75 text-xs">{note("q09").title} · 口径：{note("q09").metricNote}</figcaption>
          </figure>
        </div>
      </section>

      <section class="story-step mt-16">
        <h2 class="text-xl font-bold sm:text-2xl">六、一个反直觉的发现：周末效应不存在</h2>
        <p class="mt-3">人均行为数（总行为 ÷ 去重用户）：工作日 1.05，周末 1.05。第二个周末只是<b>人多了</b>，每个人的行为强度没有任何变化；第一个周末甚至连人都没多。「周末」在这份数据里什么也没解释——第三节看到的访客潮，是分母的潮汐，不是分子的热情。这是这份数据里最值得记住的一行。</p>
        <figure data-chart="q10" class="mt-6">
          <figcaption class="text-foreground/75 text-xs">{note("q10").title} · 口径：{note("q10").metricNote}</figcaption>
        </figure>
      </section>

      <section id="explore" class="story-step mt-16">
        <h2 class="text-xl font-bold sm:text-2xl">七、轮到你了</h2>
        <p class="mt-3">上面所有图表都是构建期固化好的预置答案。桌面端点击右下角的「开始探索」，你的浏览器会现场加载 DuckDB-WASM 查询引擎（约 {ENGINE_MB}MB，仅首次），把这份 parquet 重新算一遍——查询框提供维度、行为类型、指标与日期区间的自由组合，任何组合都是上面没画过的图。移动端只看预置图表就够了，引擎不会加载。</p>
        <p class="text-foreground/75 mt-4 text-xs">口径：查询与预置图表同源同窗（99,958 行）；时间过滤按 UTC+8 墙钟；返回条数 1-50。</p>
        <div class="mt-6" data-query-root>
          <div data-desktop-only>
            <div class="border-border bg-muted/40 grid gap-3 rounded-lg border p-4 sm:grid-cols-2">
              <label class="text-sm">
                维度
                <select id="q-dim" class="border-border bg-background mt-1 w-full rounded border px-2 py-1.5">
                  <option value="behavior_type">行为类型</option>
                  <option value="category_id">类目</option>
                  <option value="day">日期</option>
                </select>
              </label>
              <label class="text-sm">
                行为筛选
                <select id="q-behavior" class="border-border bg-background mt-1 w-full rounded border px-2 py-1.5">
                  <option value="">全部行为</option>
                  <option value="pv">仅 pv</option>
                  <option value="cart">仅 cart</option>
                  <option value="fav">仅 fav</option>
                  <option value="buy">仅 buy</option>
                </select>
              </label>
              <label class="text-sm">
                指标排序
                <select id="q-metric" class="border-border bg-background mt-1 w-full rounded border px-2 py-1.5">
                  <option value="event_count">行为数</option>
                  <option value="user_count">用户数</option>
                </select>
              </label>
              <label class="text-sm">
                返回条数（1-50）
                <input id="q-limit" type="number" min="1" max="50" value="10" class="border-border bg-background mt-1 w-full rounded border px-2 py-1.5" />
              </label>
              <label class="text-sm">
                起始日期（可空）
                <input id="q-from" type="date" min="2017-11-25" max="2017-12-03" class="border-border bg-background mt-1 w-full rounded border px-2 py-1.5" />
              </label>
              <label class="text-sm">
                结束日期（可空）
                <input id="q-to" type="date" min="2017-11-25" max="2017-12-03" class="border-border bg-background mt-1 w-full rounded border px-2 py-1.5" />
              </label>
            </div>
            <button id="q-run" class="bg-accent text-background mt-3 rounded-lg px-5 py-2 text-sm font-medium disabled:opacity-60">运行查询</button>
            <p id="q-status" class="text-foreground/75 mt-2 min-h-5 text-xs" role="status"></p>
            <div id="query-result" class="mt-3"></div>
          </div>
        </div>
      </section>

      <p class="text-foreground/75 mt-12 border-t border-border/60 pt-4 text-xs">数据为 100k 行抽样（seed=42），窗口以 ts 覆盖范围为准；结论可能随数据重抽过期。</p>
    </article>
  </main>

  <a
    href="#explore"
    class="border-border bg-background focus-outline fixed bottom-6 end-6 z-40 rounded-full border px-5 py-3 text-sm font-medium shadow-lg"
  >开始探索 ↑</a>

  <div
    id="degrade-note"
    class="border-border bg-muted text-foreground/75 fixed inset-x-0 bottom-0 z-40 hidden border-t px-4 py-3 text-center text-xs"
  >移动端展示预置图表；桌面端可自由查询。</div>

  <Footer />
</Layout>

<script>
  import scrollama from "scrollama";
  import { BEHAVIORS, DIMS, buildQuery, type QuerySpec } from "@/scripts/story/allowed-queries";

  const METRICS = ["event_count", "user_count"] as const;

  // 移动端降级：视口+触控组合判定（与 story-gates.mjs 门禁口径一致），不采信 UA
  const isMobileLike =
    window.matchMedia("(pointer: coarse)").matches || window.matchMedia("(max-width: 767px)").matches;
  if (isMobileLike) {
    document.getElementById("degrade-note")?.classList.remove("hidden");
    document.querySelector('a[href="#explore"]')?.remove();
    // 移动端绝不加载 WASM：查询表单整体移除，防触发引擎加载
    document.querySelector("[data-desktop-only]")?.remove();
  }

  // 图表懒渲染：进视口才 fetch preset 并注图（预生成 JSON 与页面同源，首拉后走 HTTP 缓存）
  const rendered = new Set<string>();
  const io = new IntersectionObserver(
    entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const host = entry.target as HTMLElement;
        const qid = host.dataset.chart;
        if (!qid || rendered.has(qid)) continue;
        rendered.add(qid);
        import("@/scripts/story/charts")
          .then(m => m.renderPreset(qid, host))
          .catch(err => {
            const p = document.createElement("p");
            p.className = "text-xs text-red-700 dark:text-red-400";
            p.textContent = `图表加载失败：${String(err)}`;
            host.append(p);
          });
        io.unobserve(host);
      }
    },
    { rootMargin: "200px 0px" },
  );
  document.querySelectorAll<HTMLElement>("figure[data-chart]").forEach(f => io.observe(f));

  // 滚动叙事：进入视口中线的 section 加 is-active
  scrollama()
    .setup({ step: ".story-step", offset: 0.5 })
    .onStepEnter(response => {
      response.element.classList.add("is-active");
    })
    .onStepExit(response => {
      response.element.classList.remove("is-active");
    });

  // 受限查询框：buildQuery 白名单拼装（唯一 SQL 收口）+ 懒加载引擎（仅首次拉 WASM）
  const status = document.getElementById("q-status");
  const runBtn = document.getElementById("q-run") as HTMLButtonElement | null;
  let engineReady = false;
  runBtn?.addEventListener("click", async () => {
    if (!runBtn || !status) return;
    status.className = "text-foreground/75 mt-2 min-h-5 text-xs";
    try {
      const dim = DIMS.find(d => d === (document.getElementById("q-dim") as HTMLSelectElement).value);
      const behavior = BEHAVIORS.find(b => b === (document.getElementById("q-behavior") as HTMLSelectElement).value);
      const metric = METRICS.find(m => m === (document.getElementById("q-metric") as HTMLSelectElement).value);
      if (!dim || !metric) throw new Error("维度或指标取值不在白名单内");
      const spec: QuerySpec = {
        dim,
        behavior,
        metric,
        limit: Number((document.getElementById("q-limit") as HTMLInputElement).value),
        dayFrom: (document.getElementById("q-from") as HTMLInputElement).value || undefined,
        dayTo: (document.getElementById("q-to") as HTMLInputElement).value || undefined,
      };
      const sql = buildQuery(spec);
      runBtn.disabled = true;
      if (!engineReady) status.textContent = "引擎加载中，仅首次需下载查询引擎…";
      const { queryParquet } = await import("@/scripts/story/duckdb-loader");
      const t0 = performance.now();
      const rows = await queryParquet<{ dim: string; event_count: number; user_count: number }>(sql);
      engineReady = true;
      runBtn.disabled = false;
      status.textContent = `引擎就绪 · ${rows.length} 行 · ${(performance.now() - t0).toFixed(0)}ms`;
      const { renderRows } = await import("@/scripts/story/charts");
      renderRows(rows, document.getElementById("query-result")!, spec.metric);
    } catch (err) {
      runBtn!.disabled = false;
      status.className = "mt-2 min-h-5 text-xs text-red-700 dark:text-red-400";
      status.textContent = `查询失败：${err instanceof Error ? err.message : String(err)}`;
    }
  });
</script>

<style>
  /* 滚动叙事的进场提示不用透明度：非激活文本会被 axe 对比度审计判 fail（a11y 门禁 ≥90），
     改用 accent 左边框标记当前节，文本始终全对比度。 */
  .story-step {
    border-inline-start: 3px solid transparent;
    padding-inline-start: 1rem;
    transition: border-color 0.4s ease;
  }
  .story-step.is-active {
    border-inline-start-color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .story-step {
      transition: none;
    }
  }
</style>
