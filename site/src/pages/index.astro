---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import toolboxShot from "@/assets/covers/toolbox.webp";
import workbenchShot from "@/assets/covers/workbench.webp";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import EvidencePanel from "@/components/EvidencePanel.astro";
import Card from "@/components/Card.astro";
import Section from "@/components/Section.astro";
import LinkButton from "@/components/LinkButton.astro";
import { sortEntries } from "@/utils/sortEntries";
import { entryUrl } from "@/utils/entryUrl";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { buildEvidence } from "@/utils/evidence";
import ContactOrbit from "@/components/ContactOrbit.astro";
import { contact } from "@/data/contact";

const t = useTranslations(Astro.currentLocale ?? config.site.lang);
const evidence = await buildEvidence();
const cases = sortEntries(await getCollection("caseStudies"));
const featuredCases = cases.filter(({ data }) => data.featured).slice(0, 3);
const latestAnalysis = sortEntries(await getCollection("analysis")).slice(0, 2);
const latestReports = sortEntries(await getCollection("toolkitReports")).slice(
  0,
  3
);
const latestDissections = sortEntries(await getCollection("dissections")).slice(
  0,
  3
);
const recordCount = (await getCollection("dissectionRecords")).length;
const toolboxTools = [
  {
    id: "competitor-analysis",
    name: "竞品分析",
    desc: "证据链标注的六章竞品报告",
  },
  {
    id: "feedback-insights",
    name: "用户反馈洞察",
    desc: "主题聚类 + 5×5 优先级矩阵",
  },
  { id: "prd-draft", name: "PRD 草稿", desc: "模板驱动，缺口标【待补充】" },
];
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout my-1">
    <section
      id="hero"
      class="border-border grid grid-cols-1 gap-8 border-b pt-8 pb-10 sm:pt-12 lg:grid-cols-12 lg:gap-10 lg:pt-16"
    >
      {
        /* 左栏 span-7；DOM 顺序即移动端顺序：面板落在 CTA 与社交链接之后，首屏不被数字占满 */
      }
      <div class="lg:col-span-7">
        <h1
          class="my-4 inline-block max-w-[13em] text-3xl leading-tight font-bold sm:my-8 sm:text-5xl"
        >
          把数据、工程和 AI 工具箱，变成可验证的产品决策。
        </h1>
        <p class="mt-2 max-w-[68ch] leading-relaxed">
          我是余翰林，重庆邮电大学"大数据管理与应用"专业，目标产品经理。
          这里放我的案例研究、数据分析报告，以及我自己设计实现的
          <a
            class="text-accent underline decoration-dashed"
            href="https://toolbox.yuhailinlxy.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            AI PM 工具箱
          </a>。
        </p>
        {
          /* 三条读者路径都摆在首屏：主入口做成"安静的小卡片"而不是纯文字链接，
             否则它和下面的次级链接完全同重，读者分不出哪个是推荐路径。
             次级链接只给已有页面（/dissections/、/case-studies/），不新增任何路由。 */
        }
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
          <LinkButton
            href="/interviewers/"
            data-astro-prefetch="viewport"
            class="border-border bg-surface-1 shadow-card hover:shadow-lift rounded-lg border px-3.5 py-2 text-sm font-semibold"
          >
            面试官快速通道（15 分钟了解这个作品集）
            <IconArrowRight class="inline-block" />
          </LinkButton>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
            <a class="text-accent underline-offset-4 hover:underline" href="/dissections/">
              看方法论 <span aria-hidden="true">→</span>
            </a>
            <a class="text-accent underline-offset-4 hover:underline" href="/case-studies/">
              看最近更新 <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        {
          config.socials.length > 0 && (
            <div class="mt-4 flex max-sm:flex-col sm:items-center">
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                {t.home.socialLinks}:
              </div>
              <Socials />
            </div>
          )
        }
      </div>

      <EvidencePanel {...evidence} />
    </section>

    {
      featuredCases.length > 0 && (
        <Section
          id="featured"
          index="01"
          zh="精选案例"
          en="SELECTED CASES"
          accent="case"
          more={{ href: "/case-studies/", label: "全部案例" }}
        >
          <ul class="mt-5 grid gap-5 sm:grid-cols-2">
            {featuredCases.map((c, i) => (
              <Card
                variant="h3"
                class={i === 0 ? "sm:col-span-2" : undefined}
                wide={i === 0}
                href={entryUrl("case-studies", c.id)}
                title={c.data.title}
                description={c.data.description}
                pubDatetime={c.data.pubDatetime}
                modDatetime={c.data.modDatetime}
                tags={c.data.tags}
                maturity={c.data.maturity}
                image={i === 0 ? workbenchShot : undefined}
                imageAlt={
                  i === 0
                    ? "个人工作台首页截图：左侧模块导航，顶部今日待办/专注/打卡/复盘四张统计卡，下方天气卡与今日热点（含「AI 日报 · 20 条 · 8 个来源」摘要）"
                    : undefined
                }
                cover={{
                  section: "case",
                  kicker: "CASE STUDY",
                  date: c.data.pubDatetime,
                  headline: c.data.metrics[0]?.value ?? "产品案例",
                  subline: c.data.metrics[0]?.label ?? "案例研究",
                  facts: c.data.metrics.slice(1, 4),
                }}
              />
            ))}
          </ul>
        </Section>
      )
    }

    {
      latestAnalysis.length > 0 && (
        <Section
          id="analysis"
          index="02"
          zh="数据分析"
          en="DATA ANALYSIS"
          accent="analysis"
          more={{ href: "/analysis/", label: "全部报告" }}
        >
          <ul class="mt-5 grid gap-5 sm:grid-cols-2">
            {latestAnalysis.map(a => (
              <Card
                variant="h3"
                href={entryUrl("analysis", a.id)}
                title={a.data.title}
                description={a.data.description}
                pubDatetime={a.data.pubDatetime}
                modDatetime={a.data.modDatetime}
                cover={{
                  section: "analysis",
                  kicker: "DATA ANALYSIS",
                  date: a.data.pubDatetime,
                  headline: a.data.dataset,
                  subline: "分析数据集",
                }}
              />
            ))}
          </ul>
        </Section>
      )
    }

    {
      latestDissections.length > 0 && (
        <Section
          id="dissections"
          index="03"
          zh="AI 产品拆解"
          en="AI TEARDOWN"
          accent="dissection"
          more={{ href: "/dissections/", label: "全部拆解" }}
        >
          <p class="mt-3 max-w-deck">
            共 {recordCount}{" "}
            条任务实测（含陷阱探测与顺从性探测），失败案例与成功案例同等呈现，判定分布由构建门禁机械核对。
          </p>
          <ul class="mt-4 grid gap-5 sm:grid-cols-2">
            {latestDissections.map(d => (
              <Card
                variant="h3"
                href={`/dissections/${d.id}/`}
                title={d.data.title}
                description={d.data.description}
                pubDatetime={d.data.pubDatetime}
                modDatetime={d.data.modDatetime}
                tags={d.data.tags}
                cover={{
                  section: "dissection",
                  kicker: "AI TEARDOWN",
                  date: d.data.pubDatetime,
                  headline: String(d.data.claims.recordCount),
                  subline: "条实测任务",
                  facts: [
                    {
                      label: "成功",
                      value: String(d.data.claims.verdicts.成功),
                    },
                    {
                      label: "部分",
                      value: String(d.data.claims.verdicts.部分),
                    },
                    {
                      label: "失败",
                      value: String(d.data.claims.verdicts.失败),
                    },
                  ],
                }}
              />
            ))}
          </ul>
        </Section>
      )
    }

    <Section
      id="data-story"
      index="04"
      zh="数据故事"
      en="DATA STORY"
      accent="story"
    >
      <p class="mt-3 max-w-deck">
        《淘宝用户行为九日谈》：8 节滚动叙事 + 12 个预置问题，DuckDB-WASM
        引擎懒加载——读者可以在浏览器里亲手复算我的数据（移动端自动降级为纯阅读）。
      </p>
      <div class="my-6">
        <LinkButton href="/data-stories/userbehavior/">
          开始阅读与复算
          <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>
    </Section>

    <Section
      id="toolbox"
      index="05"
      zh="AI PM 工具箱"
      en="TOOLKIT"
      accent="toolbox"
      divider={false}
    >
      <p class="mt-3 max-w-deck">
        它的初衷不是"再做一个聊天框"：把「先取证、再下结论」固化成一条能跑的流水线 ——
        输入材料，输出带证据标注的报告。查不到的信息标【待补充】，不让模型编一段填空。
      </p>

      {
        /* 证据分层是这一节唯一不可替代的东西：三个标签来自线上产品真实的注脚
           （"输出中的标注（【依据输入】/【行业常识】/【推断】）用于区分证据强度"），
           不是设计稿里的装饰。用户 2026-10-27 说"忘了当初为什么做它"——
           这一条就是那个"为什么"，所以放在截图之前。 */
      }
      <div class="border-border bg-surface-2 mt-5 rounded-lg border border-dashed p-4">
        <p class="text-muted-foreground font-mono text-[11px] tracking-[0.08em] uppercase">
          Evidence labels
        </p>
        <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-2 text-sm leading-relaxed">
          <span class="border-border bg-surface-1 rounded-md border px-2 py-0.5 font-mono text-xs">【依据输入】</span>
          <span class="border-border bg-surface-1 rounded-md border px-2 py-0.5 font-mono text-xs">【行业常识】</span>
          <span class="border-border bg-surface-1 rounded-md border px-2 py-0.5 font-mono text-xs">【推断】</span>
          <span class="text-muted-foreground"
            >—— 每条结论都要能回到这三者之一；三者都靠不住时，宁可留一个【待补充】。</span
          >
        </p>
      </div>
      <div class="not-prose mt-5 grid gap-5 sm:grid-cols-12 sm:items-start">
        {
          /* 全站第一张真实产品画面：PM Forge 首页（公开可访问，抓于 2026-10-27）。
             个人工作台封面仍缺——它的线上站要登录，这一格等用户提供登录后截图再补，
             不拿登录页冒充"产品界面"。 */
        }
        <a
          href="https://toolbox.yuhailinlxy.com"
          target="_blank"
          rel="noopener noreferrer"
          class="border-border shadow-card hover:shadow-lift block overflow-hidden rounded-xl border transition-[box-shadow] duration-200 sm:col-span-7"
        >
          {
            /* 浏览器框：上一版直接把 1440×810 整页截图贴上去，内容只占中间 740×480，
               四周全是空白 —— 用户的原话是"有点简陋"。现在裁到内容区（1560×1094，
               由 docs/tools/shoot-url.mjs 2× 重抓后裁切），再用一条假地址栏把它标成
               "这是个真跑起来的站"，而不是一张漂浮的截图。 */
          }
          <span class="border-border bg-surface-2 flex items-center gap-2 border-b px-3 py-2">
            <span class="flex gap-1.5" aria-hidden="true">
              <span class="bg-border size-2.5 rounded-full"></span>
              <span class="bg-border size-2.5 rounded-full"></span>
              <span class="bg-border size-2.5 rounded-full"></span>
            </span>
            <span
              class="border-border bg-surface-1 text-muted-foreground truncate rounded-md border px-2 py-0.5 font-mono text-[10px]"
              >toolbox.yuhailinlxy.com</span
            >
          </span>
          <Image
            src={toolboxShot}
            alt="PM Forge 首页：三个工具入口（竞品分析 / 用户反馈洞察 / PRD 草稿）、「已连接 · deepseek-chat」状态条，以及「数据不出浏览器、输出带证据标注」的说明"
            widths={[640, 1280]}
            sizes="(min-width: 640px) 58vw, 92vw"
            class="h-auto w-full"
            loading="lazy"
            decoding="async"
          />
        </a>
        <div class="sm:col-span-5">
          <ul class="grid gap-3">
            {
              toolboxTools.map(tool => (
                <li class="border-border bg-surface-1 rounded-lg border p-4">
                  <p class="font-semibold">{tool.name}</p>
                  <p class="text-muted-foreground mt-1 text-sm">{tool.desc}</p>
                </li>
              ))
            }
          </ul>
          {
            /* 三张卡下面补一句"共用底盘"：上一版这里是被拉高的空盒子（grid 默认 stretch），
               既不好看也没信息。现在卡片按内容高度排，空出来的位置讲真实共性。 */
          }
          <p class="text-muted-foreground mt-4 text-[13px] leading-relaxed">
            三个工具共用同一套底盘：提示词版本化、token 预算守卫、演示模式；
            输入的原始材料只留在本机浏览器里，不落服务端。
          </p>
        </div>
      </div>
      <div class="my-6 flex flex-wrap gap-4">
        <LinkButton
          href="https://toolbox.yuhailinlxy.com"
          target="_blank"
          rel="noopener noreferrer"
          class="border-border bg-surface-1 shadow-card hover:shadow-lift rounded-lg border px-3.5 py-2 text-sm font-semibold"
        >
          打开工具箱 ↗
        </LinkButton>
        <LinkButton
          href="/toolbox/"
          data-astro-prefetch="viewport"
          class="text-accent self-center text-sm hover:underline"
        >
          了解工具与精选报告
          <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>
      {
        latestReports.length > 0 && (
          <div class="mt-6 text-sm">
            <p class="text-muted-foreground">最新工具实跑报告：</p>
            <ul class="mt-2 space-y-1">
              {latestReports.map(r => (
                <li>
                  <a
                    class="text-accent underline decoration-dashed"
                    href={`/toolbox/reports/${r.id}/`}
                  >
                    {r.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </Section>
    <Section
      id="contact"
      index="06"
      zh="联系方式"
      en="CONTACT"
      accent="contact"
      divider={false}
    >
      {
        /* 顶部对齐而不是垂直居中：轨道图有 520px 高，文字只有 ~200px，
           居中会让「联系方式」标题下面空出一大块（第一版就是这个毛病）。 */
      }
      <div class="mt-4 grid gap-10 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-5">
          <p class="max-w-deck">
            我在找产品经理的岗位：能写数据分析报告，也能把方法论做成工具。
            微信 / QQ 扫码，或者直接发邮件 —— 面试、内推、项目合作都欢迎。
          </p>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <LinkButton
              href={"mailto:" + contact.email}
              class="border-border bg-surface-1 shadow-card hover:shadow-lift rounded-lg border px-3.5 py-2 text-sm font-semibold"
            >
              发邮件
            </LinkButton>
            <LinkButton
              href={contact.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent text-sm hover:underline"
            >
              GitHub ↗
            </LinkButton>
          </div>
          <p class="text-muted-foreground mt-4 font-mono text-[11px]">
            {contact.email} · QQ {contact.qq}
          </p>

          {/* 名片式三条：全部取自首屏已有的自我介绍，不新增任何事实。
              放在这里是为了让左栏不至于"上半截有字、下半截空"。 */}
          <dl class="border-border mt-7 grid grid-cols-[4.5em_1fr] gap-y-2 border-t pt-5 text-sm">
            <dt class="text-muted-foreground">学校</dt>
            <dd>重庆邮电大学</dd>
            <dt class="text-muted-foreground">专业</dt>
            <dd>大数据管理与应用</dd>
            <dt class="text-muted-foreground">方向</dt>
            <dd>产品经理 · 数据 / AI 工具</dd>
          </dl>
        </div>
        <div class="lg:col-span-7">
          <ContactOrbit />
        </div>
      </div>
    </Section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
