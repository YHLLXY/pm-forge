---
import { Image } from "astro:assets";
import Datetime from "./Datetime.astro";
import Cover, { type CoverProps } from "./Cover.astro";

type Props = {
  href: string;
  title: string;
  description: string;
  pubDatetime: Date;
  modDatetime?: Date | null;
  tags?: string[];
  variant?: "h2" | "h3";
  cover?: CoverProps | null;
  note?: string;
  /** 透传到 <li>：列表页用 sm:col-span-2 让首卡通栏 */
  class?: string;
  /** 通栏首卡：sm 起换 1120×420 的 banner 几何，小屏仍用 card 几何（同 EntryHeader 的做法） */
  wide?: boolean;
  /**
   * 真实产品截图：给了就顶替生成的 SVG 封面。
   * sectionLabel 仍从 cover 取（截图本身没有板块信息），所以两者可以同时传。
   */
  image?: ImageMetadata;
  imageAlt?: string;
  /** 成熟度标注：早期探索的作品要在卡片上就标出来，不能等点进详情页才说 */
  maturity?: { label: string; note?: string } | null;
};

const {
  href,
  title,
  description,
  pubDatetime,
  modDatetime,
  tags = [],
  variant: Heading = "h2",
  cover = null,
  note,
  class: className,
  wide = false,
  image,
  imageAlt = "",
  maturity = null,
} = Astro.props;

const sectionLabel: Record<string, string> = {
  case: "案例研究",
  analysis: "数据分析",
  dissection: "AI 产品拆解",
  story: "数据故事",
  toolbox: "工具箱报告",
};
---

<li class:list={["my-0", className]}>
  {/* data-astro-prefetch="viewport"：进入视口就预取这一页的 HTML。
      2026-10-27 实测：只挂全局 hover 预取时，线上点卡片的点击→换页是 366–581ms，
      而这 400ms 里页面没有任何反馈，读起来就是"点了没反应"。viewport 让触摸设备
      （面试官用手机看）也能提前拿到，代价是每张卡一个 HTML 请求，不拉图。 */}
  <a
    href={href}
    data-astro-prefetch="viewport"
    class="border-border bg-surface-1 shadow-card group hover:shadow-lift focus-visible:shadow-lift flex h-full flex-col overflow-hidden rounded-xl border transition-[box-shadow,translate] duration-200 ease-out focus-visible:no-underline motion-safe:hover:-translate-y-0.5 motion-safe:focus-visible:-translate-y-0.5"
  >
    {
      image && (
        <Image
          src={image}
          alt={imageAlt}
          widths={[640, 1280]}
          sizes="(min-width: 640px) 100vw, 92vw"
          class="h-auto w-full"
          loading="lazy"
          decoding="async"
        />
      )
    }
    {
      !image &&
        cover &&
        (wide ? (
          <>
            <div class="sm:hidden">
              <Cover {...cover} variant="card" />
            </div>
            <div class="hidden sm:block">
              <Cover {...cover} variant="banner" />
            </div>
          </>
        ) : (
          <Cover {...cover} />
        ))
    }
    <div class="flex flex-1 flex-col p-4 sm:p-5">
      <div
        class="text-muted-foreground mb-2 flex items-center justify-between gap-3 text-xs"
      >
        {
          cover && (
            <span
              class="font-semibold tracking-wide"
              style={`color: var(--section-${cover.section})`}
            >
              {sectionLabel[cover.section]}
            </span>
          )
        }
        <Datetime {pubDatetime} {modDatetime} />
      </div>
      {
        maturity && (
          <p class="mb-1.5">
            <span
              class="inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-semibold tracking-wide"
              style="color: var(--warm); border-color: color-mix(in oklab, var(--warm) 38%, transparent); background: color-mix(in oklab, var(--warm) 8%, transparent);"
            >
              {maturity.label}
            </span>
          </p>
        )
      }
      <Heading
        class="group-hover:text-accent group-focus-visible:text-accent text-lg leading-snug font-semibold tracking-tight"
      >
        {title}
      </Heading>
      <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
        {description}
      </p>
      {
        note && (
          <p class="text-muted-foreground mt-2 font-mono text-xs">{note}</p>
        )
      }
      {
        tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2">
            {tags.map(tag => (
              <li class="border-border bg-surface-2 text-muted-foreground rounded-md border px-2 py-0.5 text-xs">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </a>
</li>
