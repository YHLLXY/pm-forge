---
import Datetime from "./Datetime.astro";
import Cover, { type CoverProps } from "./Cover.astro";

type Props = {
  href: string;
  title: string;
  description: string;
  pubDatetime: Date;
  modDatetime?: Date | null;
  tags?: string[];
  variant?: "h2" | "h3";
  cover?: CoverProps | null;
  note?: string;
};

const {
  href,
  title,
  description,
  pubDatetime,
  modDatetime,
  tags = [],
  variant: Heading = "h2",
  cover = null,
  note,
} = Astro.props;

const sectionLabel: Record<string, string> = {
  case: "案例研究",
  analysis: "数据分析",
  dissection: "AI 产品拆解",
  story: "数据故事",
  toolbox: "工具箱报告",
};
---

<li class="my-0">
  <a
    href={href}
    class="border-border bg-surface-1 shadow-card group hover:shadow-lift focus-visible:shadow-lift flex h-full flex-col overflow-hidden rounded-xl border transition-[box-shadow,translate] duration-200 ease-out focus-visible:no-underline motion-safe:hover:-translate-y-0.5 motion-safe:focus-visible:-translate-y-0.5"
  >
    {cover && <Cover {...cover} />}
    <div class="flex flex-1 flex-col p-4 sm:p-5">
      <div
        class="text-muted-foreground mb-2 flex items-center justify-between gap-3 text-xs"
      >
        {
          cover && (
            <span
              class="font-semibold tracking-wide"
              style={`color: var(--section-${cover.section})`}
            >
              {sectionLabel[cover.section]}
            </span>
          )
        }
        <Datetime {pubDatetime} {modDatetime} />
      </div>
      <Heading
        class="group-hover:text-accent group-focus-visible:text-accent text-lg leading-snug font-semibold tracking-tight"
      >
        {title}
      </Heading>
      <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
        {description}
      </p>
      {
        note && (
          <p class="text-muted-foreground mt-2 font-mono text-xs">{note}</p>
        )
      }
      {
        tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2">
            {tags.map(tag => (
              <li class="border-border bg-surface-2 text-muted-foreground rounded-md border px-2 py-0.5 text-xs">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </a>
</li>
