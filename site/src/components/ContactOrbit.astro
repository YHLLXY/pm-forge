---
// ContactOrbit.astro —— 首页 §06 的"联系方式轨道图"
//
// 设计来源：用户 2026-10-27 指定参考图（同心圆点阵 + 中心字 + 环绕的渠道节点）。
// 照抄的是**结构**（同心点阵 + 环上节点 + 中心字），不是像素。
// 节点最初是文字徽标；2026-10-28 用户要求换成各家图标（"QQ 是企鹅，微信是绿泡泡"），
// 改用 Simple Icons 的 CC0 图形，配色见下方 .cicon 的注释。
//
// 动效为什么这么写：
//   · 不用 offset-path: circle() —— Safari 16 对基本形状的支持面不稳，面试官可能用 Mac；
//   · 用"外层自转 + 内层反向自转"：兼容所有浏览器，且节点文字永远正立；
//   · 相位差用负 animation-delay，不写四份 keyframes；
//   · reduce 下关掉动画，但用 --phase 把节点钉在四个方位（否则四个节点会叠在 12 点）。
import { contact } from "@/data/contact";
---

<div class="cosys" data-cosys>
  {
    /* 三条环各自一个 <div>：早期版本把三个 <circle> 放在同一个 SVG 里直接转，
       SVG 元素的 transform-origin 默认是 viewBox 左上角而不是圆心，转起来整条环
       会绕着角落飘（实测三个环心分别偏了 33/23/22px）。改成"每个环一个 HTML 容器"，
       转的永远是容器的中心，不需要依赖 transform-box。 */
  }
  <div class="cring cring-a" aria-hidden="true">
    <svg viewBox="0 0 400 400" class="size-full">
      <circle class="ring" cx="200" cy="200" r="168"></circle>
    </svg>
  </div>
  <div class="cring cring-b" aria-hidden="true">
    <svg viewBox="0 0 400 400" class="size-full">
      <circle class="ring" cx="200" cy="200" r="128"></circle>
    </svg>
  </div>
  <div class="cring cring-c" aria-hidden="true">
    <svg viewBox="0 0 400 400" class="size-full">
      <circle class="ring" cx="200" cy="200" r="96"></circle>
    </svg>
  </div>

  <div class="ccore" aria-hidden="true">
    <span class="cmark">余</span>
    <span class="cdot" title="目前开放机会"></span>
  </div>

  <div class="corb" style="--r: 42%; --dur: 72s; --phase: 0; --rotor: turn-cw; --node: turn-ccw">
    <div class="crotor">
      <div class="cslot">
        <button type="button" class="cnode" data-dialog="dlg-wechat" aria-label="微信：打开二维码" title="微信">
          <svg class="cicon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 0 1 .598.082l1.584.926a.272.272 0 0 0 .14.047c.134 0 .24-.111.24-.247 0-.06-.023-.12-.038-.177l-.327-1.233a.582.582 0 0 1-.023-.156.49.49 0 0 1 .201-.398C23.024 18.48 24 16.82 24 14.98c0-3.21-2.931-5.837-6.656-6.088V8.89c-.135-.01-.27-.027-.407-.03zm-2.53 3.274c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.97-.982zm4.844 0c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.969-.982z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="corb" style="--r: 42%; --dur: 72s; --phase: 0.5; --rotor: turn-cw; --node: turn-ccw">
    <div class="crotor">
      <div class="cslot">
        <button type="button" class="cnode" data-dialog="dlg-qq" aria-label="QQ：打开二维码" title="QQ">
          <svg class="cicon cicon-qq" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <path d="M23.7927 44.5178C20.1344 44.5178 16.7762 43.2933 14.6142 41.4646C13.5161 41.7927 12.1115 42.3204 11.2254 42.9751C10.4664 43.535 10.5613 44.1059 10.6979 44.3362C11.298 45.3491 20.9938 44.9831 23.7927 44.6678V44.5178ZM23.7927 44.5178C27.4516 44.5178 30.8095 43.2933 32.9718 41.4646C34.0693 41.7927 35.4742 42.3204 36.3606 42.9751C37.119 43.535 37.0244 44.1059 36.8875 44.3362C36.2874 45.3491 26.5919 44.9831 23.7927 44.6678V44.5178Z"/>
            <path fill-rule="evenodd" d="M36.3386 20.9326C34.6979 21.3809 29.856 22.5505 23.8144 22.5914H23.7698C17.5753 22.5491 12.6423 21.3214 11.1274 20.8999C10.816 20.8129 10.6458 20.6334 10.6458 20.6334C10.644 20.5785 10.6207 19.6503 10.6207 19.171C10.6207 11.1055 14.4284 3.00029 23.7922 3C33.1561 3.00029 36.9635 11.1052 36.9635 19.1713C36.9635 19.65 36.9402 20.5785 36.9387 20.6337C36.9387 20.6337 36.7297 20.8255 36.3386 20.9326ZM38.8284 25.3504C39.3462 26.7001 39.8573 28.1055 40.2318 29.3107C42.0176 35.0578 41.4388 37.4364 40.9986 37.4898C40.0532 37.6039 37.3187 33.1634 37.3187 33.1634C37.3187 37.6757 33.2448 44.604 23.916 44.6677H23.6685C14.3394 44.604 10.2655 37.6757 10.2655 33.1634C10.2655 33.1634 7.53131 37.6039 6.58588 37.4895C6.14542 37.4364 5.5666 35.0581 7.35268 29.3107C7.72717 28.1058 8.23827 26.7001 8.75609 25.3504C8.75609 25.3504 9.10519 25.3285 9.28207 25.3795C10.7319 25.798 12.2762 26.1689 13.8447 26.4792C13.5776 28.1343 13.4249 30.1827 13.5692 32.6021C13.9533 39.0363 17.7745 43.081 23.6727 43.1394H23.9121C29.8106 43.081 33.6314 39.0363 34.0161 32.6021C34.1604 30.1823 34.0075 28.1345 33.7402 26.4793C35.3363 26.1633 36.9076 25.7848 38.3798 25.3571C38.5307 25.3136 38.8284 25.3504 38.8284 25.3504ZM33.7402 26.4793C30.3004 27.1601 26.7448 27.5502 23.8144 27.5147H23.7698C20.8396 27.5498 17.2841 27.1598 13.8447 26.4792C13.8586 26.3929 13.8728 26.3076 13.8874 26.2234C17.3136 26.8989 20.8513 27.2853 23.769 27.2503H23.8137L23.814 27.25C26.7323 27.2856 30.2709 26.8989 33.6974 26.2231C33.712 26.3074 33.7262 26.3928 33.7402 26.4793ZM18.0376 11.6868C18.1059 13.5266 19.1912 14.9735 20.4615 14.916C21.7309 14.8594 22.7044 13.3208 22.6349 11.4802C22.566 9.6398 21.4811 8.19348 20.2122 8.2504C18.9419 8.30791 17.9687 9.84646 18.0376 11.6868ZM27.1253 14.916C28.3957 14.9735 29.4809 13.5263 29.5489 11.6868C29.6181 9.84646 28.6449 8.30791 27.3746 8.2504C26.1055 8.19378 25.0208 9.64009 24.9519 11.4805C24.8825 13.3208 25.8556 14.8591 27.1253 14.916ZM23.8148 15.9248C28.0469 15.9248 31.4658 16.7625 31.805 17.5141V17.5144C31.821 17.5477 31.8295 17.5841 31.8298 17.621C31.8294 17.6731 31.8131 17.7238 31.7831 17.7663C31.497 18.1835 27.701 20.2436 23.8148 20.2436H23.7692C19.8827 20.2436 16.0867 18.1829 15.8006 17.7663C15.7708 17.7239 15.7545 17.6734 15.7539 17.6216C15.7542 17.5845 15.7627 17.5479 15.7787 17.5144C16.1182 16.7625 19.5368 15.9248 23.7692 15.9248H23.8148Z" clip-rule="evenodd"/>
            <path d="M22.0218 11.7142C22.0799 12.441 21.6812 13.0867 21.1327 13.157C20.5831 13.2277 20.0912 12.6958 20.0329 11.969C19.9754 11.2416 20.3735 10.596 20.9211 10.5259C21.4716 10.4547 21.9643 10.9871 22.0218 11.7139V11.7142ZM25.5117 11.9571C25.624 11.7559 26.3885 10.6984 27.9714 11.0834C28.3874 11.1847 28.5797 11.3336 28.6203 11.392C28.6801 11.4784 28.6968 11.6015 28.6358 11.7673C28.5155 12.096 28.2671 12.087 28.1296 12.0227C28.0406 11.9813 26.9381 11.2463 25.9223 12.3429C25.8523 12.418 25.7274 12.4439 25.6091 12.3546C25.4903 12.2647 25.4416 12.0832 25.5117 11.9571Z"/>
            <path d="M15.5039 26.7117V33.0437C15.5039 33.0437 18.4044 33.6286 21.3105 33.2235V27.383C19.4695 27.2788 17.4841 27.0468 15.5039 26.7117Z"/>
            <path d="M36.9385 20.6337C36.9385 20.6337 31.2962 22.4148 23.8142 22.4653H23.7695C16.2998 22.4151 10.6648 20.6395 10.6456 20.6337L8.75586 25.35C13.4824 26.775 19.3401 27.6933 23.7695 27.6399H23.8142C28.2436 27.6933 34.101 26.775 38.8282 25.35L36.9385 20.6337Z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="corb" style="--r: 32%; --dur: 54s; --phase: 0.25; --rotor: turn-ccw; --node: turn-cw">
    <div class="crotor">
      <div class="cslot">
        <button type="button" class="cnode" data-dialog="dlg-mail" aria-label="邮箱：查看与复制地址" title="邮箱">
          <svg class="cicon cicon-mail" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4.8 5.4h14.4A2.8 2.8 0 0 1 22 8.2v7.6a2.8 2.8 0 0 1-2.8 2.8H4.8A2.8 2.8 0 0 1 2 15.8V8.2a2.8 2.8 0 0 1 2.8-2.8Z"></path>
            <path class="cicon-cut" d="m3.5 7.6 7.5 5.3a1.9 1.9 0 0 0 2 0l7.5-5.3"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="corb" style="--r: 24%; --dur: 40s; --phase: 0.75; --rotor: turn-ccw; --node: turn-cw">
    <div class="crotor">
      <div class="cslot">
        <button type="button" class="cnode" data-dialog="dlg-github" aria-label="GitHub：查看主页" title="GitHub">
          <svg class="cicon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<p class="text-muted-foreground mt-1 text-center text-[11px]">
  微信 · QQ · 邮箱 · GitHub —— 点圆点开二维码或地址<span class="max-sm:hidden">；鼠标移到圆点上会暂停，方便你点</span>
</p>

<dialog id="dlg-wechat" class="cdlg" aria-labelledby="dlg-wechat-t">
  <div class="cdlg-body">
    <p id="dlg-wechat-t" class="cdlg-title">微信</p>
    <img
      src={contact.wechatQr}
      alt="余翰林的微信二维码"
      width="480"
      height="480"
      class="cdlg-qr"
      loading="lazy"
      decoding="async"
    />
    <p class="cdlg-note">微信扫一扫。备注「面试」，我会优先回。</p>
    <form method="dialog">
      <button class="cdlg-close">关闭</button>
    </form>
  </div>
</dialog>

<dialog id="dlg-qq" class="cdlg" aria-labelledby="dlg-qq-t">
  <div class="cdlg-body">
    <p id="dlg-qq-t" class="cdlg-title">QQ</p>
    <img
      src={contact.qqQr}
      alt="余翰林的 QQ 二维码"
      width="480"
      height="480"
      class="cdlg-qr"
      loading="lazy"
      decoding="async"
    />
    <p class="cdlg-value">{contact.qq}</p>
    <div class="cdlg-actions">
      <button type="button" class="cdlg-copy" data-copy={contact.qq}>复制 QQ 号</button>
      <form method="dialog"><button class="cdlg-close">关闭</button></form>
    </div>
  </div>
</dialog>

<dialog id="dlg-mail" class="cdlg" aria-labelledby="dlg-mail-t">
  <div class="cdlg-body">
    <p id="dlg-mail-t" class="cdlg-title">邮箱</p>
    <p class="cdlg-value">{contact.email}</p>
    <div class="cdlg-actions">
      <button type="button" class="cdlg-copy" data-copy={contact.email}>复制地址</button>
      <a class="cdlg-primary" href={"mailto:" + contact.email}>用邮件客户端打开</a>
    </div>
    <form method="dialog"><button class="cdlg-close cdlg-close--full">关闭</button></form>
  </div>
</dialog>

<dialog id="dlg-github" class="cdlg" aria-labelledby="dlg-github-t">
  <div class="cdlg-body">
    <p id="dlg-github-t" class="cdlg-title">GitHub</p>
    <p class="cdlg-value">github.com/{contact.githubName}</p>
    <div class="cdlg-actions">
      <button type="button" class="cdlg-copy" data-copy={contact.github}>复制链接</button>
      <a class="cdlg-primary" href={contact.github} target="_blank" rel="noopener noreferrer">打开主页 ↗</a>
    </div>
    <form method="dialog"><button class="cdlg-close cdlg-close--full">关闭</button></form>
  </div>
</dialog>

<style>
  .cosys {
    --node-size: clamp(44px, 12vw, 52px);
    position: relative;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    aspect-ratio: 1;
    touch-action: manipulation;
    /* 旋转的 .crotor 是 inset:0 的方框，一转起来四个角就超出容器，
       移动端因此多出 27px 横向滚动（实测 docScrollWidth 417 > 390）。裁掉即可。 */
    overflow: hidden;
  }

  .cring {
    position: absolute;
    inset: 0;
  }

  /* 命中测试：.cring / .ccore / .corb / .crotor 都是 inset:0 的满幅方框，透明但**能接收点击**。
     后出现的 .corb 会把前面几个节点整个盖住 —— 实测（2026-10-28）四个节点里只有 DOM 里
     最后一个（GitHub）能点到，其余三个点下去落在别人的 .crotor 上，什么也不会发生。
     所以只让节点本身接收指针，装饰层一律放行。 */
  .cring,
  .ccore,
  .corb {
    pointer-events: none;
  }
  .cnode {
    pointer-events: auto;
  }
  /* 点阵颜色：用 muted-foreground + stroke-opacity，而不是 border 色 —— 第一版直接用
     border token，在米白底上几乎看不见，整张图读起来像"几个孤零零的圆"。 */
  .ring {
    fill: none;
    stroke: var(--muted-foreground);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 0.1 8;
  }
  .cring-a {
    animation: ring-turn 150s linear infinite;
  }
  .cring-b {
    animation: ring-turn 190s linear infinite reverse;
  }
  .cring-c {
    animation: ring-turn 230s linear infinite;
  }
  .cring-a .ring {
    stroke-opacity: 0.4;
  }
  .cring-b .ring {
    stroke-opacity: 0.3;
  }
  .cring-c .ring {
    stroke-opacity: 0.22;
  }

  .ccore {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
  }
  .cmark {
    display: grid;
    place-content: center;
    width: clamp(64px, 15vw, 88px);
    aspect-ratio: 1;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-1);
    box-shadow: var(--shadow-1);
    font-size: clamp(24px, 6vw, 30px);
    font-weight: 700;
    line-height: 1;
  }
  /* 状态点：贴在中心圆的左上边缘，像一个"在线"徽标；外面一圈 surface 色做镂空 */
  .cdot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 10px;
    transform: translate(clamp(14px, 4vw, 20px), clamp(-56px, -15vw, -46px));
    border-radius: 999px;
    background: var(--section-toolbox);
    box-shadow: 0 0 0 3px var(--background);
    animation: cdot-pulse 2.8s ease-out infinite;
  }

  .corb {
    position: absolute;
    inset: 0;
  }
  .crotor {
    position: absolute;
    inset: 0;
    animation: var(--rotor) var(--dur) linear infinite;
    animation-delay: calc(var(--dur) * -1 * var(--phase));
  }
  .cslot {
    position: absolute;
    left: 50%;
    top: calc(50% - var(--r));
    transform: translate(-50%, -50%);
  }
  .cnode {
    display: grid;
    place-content: center;
    width: var(--node-size);
    height: var(--node-size);
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-1);
    box-shadow: var(--shadow-1);
    color: var(--foreground);
    cursor: pointer;
    animation: var(--node) var(--dur) linear infinite;
    animation-delay: calc(var(--dur) * -1 * var(--phase));
    transition:
      box-shadow 180ms ease-out,
      border-color 180ms ease-out,
      scale 180ms ease-out;
  }
  /* 图标：2026-10-28 按用户要求，把节点里的文字换成各家自己的图形。
     来源：微信 / GitHub 用 Simple Icons（CC0 1.0，https://simpleicons.org/icons）；
     QQ 用 IconPark（Apache-2.0，https://github.com/bytedance/IconPark）—— Simple Icons 那版
     是纯剪影，27px 下眼睛和肚子全糊掉，看不出是企鹅；IconPark 这版用 evenodd 挖出眼睛和白肚，
     缩到 27px 仍认得出。邮箱是自绘。
     WeChat / QQ / GitHub 是三家权利人的商标，这里仅用于指认本人的联系渠道（nominative use）。
     配色只给微信用它本来的绿，其余三个走前景色 —— 深色主题下自动反白，不用再写一套。 */
  .cicon {
    display: block;
    width: 54%;
    height: auto;
    fill: currentColor;
  }
  .cnode[data-dialog="dlg-wechat"] .cicon {
    /* Simple Icons 的微信图形自带留白，同样 54% 会比别的显小，放到 60% 才等大 */
    width: 60%;
    fill: var(--brand-wechat);
  }
  .cicon-mail {
    width: 52%;
  }
  /* IconPark 的企鹅把 48 的画布占满，同样 54% 会比周边三个显大，压到 50% 才齐平 */
  .cicon-qq {
    width: 50%;
  }
  /* 邮箱是自己画的：实心信封 + 一道用卡片底色描出来的折线。不用挖洞，
     换主题、换底色都不会露出奇怪的边。 */
  .cicon-mail .cicon-cut {
    fill: none;
    stroke: var(--surface-1);
    stroke-width: 2.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cnode:hover,
  .cnode:focus-visible {
    border-color: var(--accent);
    box-shadow: var(--shadow-2);
    scale: 1.1;
  }
  .cnode:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* 只在指针落进某个节点、或键盘聚焦某个节点时暂停整套。
     不要写成 .cosys:hover —— 容器是 520px 的方框，鼠标一进这块区域动画就停，
     会让人以为"这块区域是静止的"（用户 2026-10-28 反馈）。 */
  .cosys[data-paused] .crotor,
  .cosys[data-paused] .cnode {
    animation-play-state: paused;
  }

  @keyframes turn-cw {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes turn-ccw {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-360deg);
    }
  }
  @keyframes ring-turn {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes cdot-pulse {
    0% {
      box-shadow: 0 0 0 0 var(--section-toolbox);
    }
    70% {
      box-shadow: 0 0 0 7px rgb(0 0 0 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(0 0 0 / 0);
    }
  }

  .cdlg {
    margin: auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface-1);
    color: var(--foreground);
    width: min(92vw, 360px);
    box-shadow: var(--shadow-2);
  }
  .cdlg::backdrop {
    background: rgb(0 0 0 / 0.42);
  }
  .cdlg-body {
    padding: 18px;
    text-align: center;
  }
  .cdlg-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .cdlg-qr {
    display: block;
    width: 200px;
    height: 200px;
    margin: 14px auto 0;
    border-radius: 8px;
    border: 1px solid var(--border);
  }
  .cdlg-value {
    margin-top: 14px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 15px;
    word-break: break-all;
  }
  .cdlg-note {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted-foreground);
  }
  .cdlg-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 16px;
  }
  .cdlg-copy,
  .cdlg-primary,
  .cdlg-close {
    border-radius: 8px;
    border: 1px solid var(--border);
    padding: 7px 12px;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    background: var(--surface-2);
    color: var(--foreground);
  }
  .cdlg-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-foreground);
    text-decoration: none;
  }
  .cdlg-close {
    margin-top: 16px;
    width: 100%;
    background: transparent;
  }
  .cdlg-close--full {
    margin-top: 10px;
  }
  .cdlg-copy[data-copied="1"] {
    border-color: var(--section-toolbox);
    color: var(--section-toolbox);
  }
  .cdlg-copy:hover,
  .cdlg-close:hover {
    border-color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .cring-a,
    .cring-b,
    .cring-c,
    .cdot {
      animation: none;
    }
    .crotor {
      animation: none;
      transform: rotate(calc(var(--phase) * 360deg));
    }
    .cnode {
      animation: none;
      transition: none;
      transform: rotate(calc(var(--phase) * -360deg));
    }
    .cnode:hover,
    .cnode:focus-visible {
      scale: 1;
    }
  }


</style>

<script>
  // 暂停：只有指针进入某个节点（或键盘聚焦）才停，停的是整套 —— 停在节点上才好点。
  // 难点是 CSS 里没有"只命中节点"的选择器：.corb / .crotor 都是 inset:0 的满幅方框，
  // 写 .corb:hover 等于整块区域悬停。:has 在旧 Safari 上不可靠，所以用委托事件开关属性。
  // 必须走 document 级委托：ClientRouter 换页后节点是新 DOM，模块脚本不会重新执行。
  const setOrbitPaused = (el: Element | null, on: boolean) => {
    const sys = el instanceof Element ? el.closest("[data-cosys]") : null;
    if (!sys) return;
    if (on) sys.setAttribute("data-paused", "");
    else sys.removeAttribute("data-paused");
  };
  const orbitNode = (target: EventTarget | null) =>
    target instanceof Element ? target.closest(".cnode") : null;

  document.addEventListener("pointerover", event => {
    const node = orbitNode(event.target);
    if (node) setOrbitPaused(node, true);
  });
  document.addEventListener("pointerout", event => {
    const node = orbitNode(event.target);
    if (node) setOrbitPaused(node, false);
  });
  document.addEventListener("focusin", event => {
    const node = orbitNode(event.target);
    // 只有键盘聚焦才停：点开对话框再关闭时焦点会回到按钮，不该让整套一直停着。
    if (node && node.matches(":focus-visible")) setOrbitPaused(node, true);
  });
  document.addEventListener("focusout", event => {
    const node = orbitNode(event.target);
    if (node) setOrbitPaused(node, false);
  });

  // 弹层：原生 <dialog> 自带焦点陷阱与 Esc，这里只补"点遮罩关闭""复制"。
  document.addEventListener("click", event => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const opener = target.closest("[data-dialog]");
    if (opener) {
      const id = opener.getAttribute("data-dialog");
      const dlg = id ? document.getElementById(id) : null;
      if (dlg instanceof HTMLDialogElement && !dlg.open) dlg.showModal();
      return;
    }

    const copyBtn = target.closest("[data-copy]");
    if (copyBtn) {
      const text = copyBtn.getAttribute("data-copy") || "";
      const original = copyBtn.textContent;
      const done = () => {
        copyBtn.setAttribute("data-copied", "1");
        copyBtn.textContent = "已复制";
        window.setTimeout(() => {
          copyBtn.setAttribute("data-copied", "0");
          copyBtn.textContent = original;
        }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done, done);
      } else {
        done();
      }
      return;
    }

    if (target instanceof HTMLDialogElement && target.classList.contains("cdlg")) {
      target.close();
    }
  });
</script>
