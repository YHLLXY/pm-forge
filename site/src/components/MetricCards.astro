---
type Metric = { label: string; value: string; note?: string };
type Props = { metrics: Metric[]; resultsNote?: string };
const { metrics = [], resultsNote } = Astro.props;
---

{
  metrics.length > 0 && (
    <ul class="not-prose my-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
      {metrics.map(m => (
        <li class="rounded-lg border border-border bg-muted/40 p-3">
          <p class="text-xs text-foreground/75">{m.label}</p>
          <p class="mt-1 text-xl font-bold text-accent">{m.value}</p>
          {m.note && (
            <p class="mt-1 text-xs text-foreground/75">{m.note}</p>
          )}
        </li>
      ))}
    </ul>
  )
}
{
  metrics.length === 0 && resultsNote && (
    <p class="not-prose my-4 rounded-lg border border-dashed border-border bg-muted/30 p-3 text-sm text-foreground/75">
      {resultsNote}
    </p>
  )
}
