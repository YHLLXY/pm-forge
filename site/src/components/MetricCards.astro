---
type Metric = { label: string; value: string; note?: string };
type Props = { metrics: Metric[]; resultsNote?: string };
const { metrics = [], resultsNote } = Astro.props;
---

{
  metrics.length > 0 && (
    <dl class="not-prose my-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
      {metrics.map(m => (
        <div class="rounded-lg border border-border bg-muted/40 p-3">
          <dt class="text-xs text-muted-foreground">{m.label}</dt>
          <dd class="mt-1 text-xl font-bold text-accent">{m.value}</dd>
          {m.note && <p class="mt-1 text-xs text-muted-foreground">{m.note}</p>}
        </div>
      ))}
    </dl>
  )
}
{
  metrics.length === 0 && resultsNote && (
    <p class="not-prose my-4 rounded-lg border border-dashed border-border bg-muted/30 p-3 text-sm text-muted-foreground">
      {resultsNote}
    </p>
  )
}
