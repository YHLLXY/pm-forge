{
  "name": "pm-forge-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/copy-duckdb-assets.mjs && astro check && astro build && node scripts/check-case-studies.mjs && node scripts/check-dissections.mjs && node scripts/check-links.mjs && node scripts/validate-rss.mjs && node scripts/check-ld.mjs && node scripts/check-story-budget.mjs && pagefind --site dist",
    "check:story-budget": "node scripts/check-story-budget.mjs",
    "check:story": "node scripts/story-gates.mjs",
    "check:content": "node scripts/check-case-studies.mjs",
    "check:dissections": "node scripts/check-dissections.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:rss": "node scripts/validate-rss.mjs",
    "check:ld": "node scripts/check-ld.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lh": "node scripts/lh.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@observablehq/plot": "0.6.17",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.3",
    "dayjs": "^1.11.21",
    "rehype-callouts": "^2.2.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "scrollama": "3.2.0",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@shikijs/transformers": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "lighthouse": "^13.5.0",
    "pagefind": "^1.5.2",
    "prettier": "3.9.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3"
