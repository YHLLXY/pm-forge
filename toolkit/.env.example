# 复制为 .env 并填入真实值；.env 已被 gitignore，永不入库
# DeepSeek（默认，国内直连）：https://platform.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# GLM 备选（注释切换）：
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.6
# 单次请求输入 token 估算上限（超出需用户显式确认）
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_OUTPUT_TOKENS=4096
# 置 1 强制演示模式（固定样例输出，用于开发/测试/无 Key 演示）
MOCK_LLM=
